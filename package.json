{
  "name": "minesweeper-together",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A real-time game table for the same room: Minesweeper, Sudoku, Klondike, and FreeCell.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build && tsup src/server/index.ts --format esm --out-dir dist/server --clean --sourcemap",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}
